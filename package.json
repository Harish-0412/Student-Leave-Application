{
  "name": "student-leave-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite --config client/vite.config.js",
    "dev:server": "cd server && npm run dev",
    "build": "vite build --config client/vite.config.js",
    "lint": "eslint .",
    "preview": "vite preview --config client/vite.config.js",
    "test": "cd server && npm test"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.37",
    "@radix-ui/react-slot": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "react-day-picker": "^9.3.0",
    "tailwind-merge": "^3.5.0",
    "axios": "^1.6.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "firebase": "^12.4.0",
    "firebase-admin": "^12.0.0",
    "framer-motion": "^12.23.24",
    "groq": "^5.19.0",
    "lucide-react": "^1.7.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "react-router-dom": "^7.14.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jest": "^29.0.0",
    "nodemon": "^3.0.0",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.1"
  }
